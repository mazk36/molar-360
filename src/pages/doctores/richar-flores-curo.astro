---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import CTA from '../../components/CTA.astro';
import { clinic } from '../../data/clinic';
const person = clinic.professionals[1];
---

<SiteLayout title="Dr. Richar Flores Curo | MOLAR 360" description="Información y contacto oficial del Dr. Richar Flores Curo, profesional vinculado a MOLAR 360." path={person.page}>
  <PageHero
    title={person.displayName}
    description="Profesional vinculado a MOLAR 360 en los canales oficiales de la clínica."
    aside="Otros datos profesionales no se han añadido porque aún no están confirmados."
    breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Profesionales', href: '/doctores/' }, { label: person.displayName }]}
  />
  <section class="section section--surface">
    <div class="profile-layout wrap">
      <PhotoPlaceholder label="Retrato del Dr. Richar Flores Curo" filename="doctor-richar-flores-curo.webp" aspect="4:5" resolution="1200 × 1500 px" description="Retrato profesional real del Dr. Richar Flores Curo, con autorización para publicación." variant="portrait" />
      <div>
        <p class="eyebrow">MOLAR 360 · Profesional</p>
        <h2>Información disponible</h2>
        <p>El Dr. Richar Flores Curo aparece en el Linktree oficial de MOLAR 360 junto a un contacto directo de WhatsApp.</p>
        <dl class="profile-facts">
          <div><dt>Nombre</dt><dd>{person.displayName}</dd></div>
          <div><dt>Vinculación</dt><dd>MOLAR 360 · Clínica Odontológica</dd></div>
          <div><dt>Contacto</dt><dd><a href={person.waLink} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click">WhatsApp · {person.phone} ↗</a></dd></div>
        </dl>
        <p>La especialidad, la formación, las credenciales y la experiencia están pendientes de confirmación.</p>
        <a class="button button--dark" href={person.waLink} target="_blank" rel="noopener noreferrer" data-event="appointment_cta">Escribir por WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <CTA title="Solicita información directamente." text="Escribe al Dr. Richar Flores Curo por su WhatsApp oficial para consultar y coordinar una cita." />
</SiteLayout>

---
import { clinic, sitePath } from '../data/clinic';
const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Nosotros', href: '/nosotros/' },
  { label: 'Profesionales', href: '/doctores/' },
  { label: 'Preguntas', href: '/preguntas-frecuentes/' },
  { label: 'Ubicación', href: '/ubicacion/' },
];
---

<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="header-inner wrap">
    <a class="wordmark" href={sitePath('/')} aria-label="MOLAR 360, inicio">
      <span class="wordmark__name">MOLAR <b>360</b></span>
      <span class="wordmark__descriptor">CLÍNICA ODONTOLÓGICA</span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {links.map((link) => <a href={sitePath(link.href)}>{link.label}</a>)}
    </nav>
    <a class="button button--dark header-cta" href={clinic.professionals[0].waLink} target="_blank" rel="noopener noreferrer" data-event="appointment_cta">Agendar cita <span aria-hidden="true">↗</span></a>
    <a class="button button--dark mobile-header-cta" href={clinic.professionals[0].waLink} target="_blank" rel="noopener noreferrer" aria-label="Agendar cita por WhatsApp" data-event="appointment_cta">WhatsApp <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary aria-label="Abrir menú de navegación"><span class="mobile-menu__label">Menú</span><span class="mobile-menu__icon" aria-hidden="true"><i></i><i></i></span></summary>
      <nav aria-label="Navegación móvil">
        {links.map((link) => <a href={sitePath(link.href)}>{link.label}</a>)}
        <a class="mobile-menu__cta" href={clinic.professionals[0].waLink} target="_blank" rel="noopener noreferrer" data-event="appointment_cta">Agendar por WhatsApp ↗</a>
      </nav>
    </details>
  </div>
</header>
